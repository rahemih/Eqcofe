NODE_ENV=development
SERVICE_NAME=eqcofe
API_PORT=3000
OPENAPI_DOCS_ENABLED=true

DATABASE_URL=postgresql://eqcofe:eqcofe@127.0.0.1:5432/eqcofe
DB_POOL_MAX=20

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_PROCESSING_TIMEOUT_MS=30000
OUTBOX_MAX_ATTEMPTS=12
EVENT_PIPELINE_SUMMARY_INTERVAL_MS=60000
NOTIFICATION_POLL_INTERVAL_MS=500
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_PROCESSING_TIMEOUT_MS=300000
HEALTH_READINESS_TIMEOUT_MS=5000


# Step 32 Identity/Auth
AUTH_ENCRYPTION_KEY=replace-with-a-long-random-secret
OTP_HMAC_SECRET=replace-with-a-different-long-random-secret
OTP_TTL_SECONDS=120
SESSION_TTL_SECONDS=604800
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
AUTH_TOKEN_HMAC_SECRET=replace-with-third-independent-long-random-secret
COOKIE_SECURE=false
BROWSER_ALLOWED_ORIGINS=http://localhost:3000

# Commerce lifecycle
CART_TTL_HOURS=168
CART_ACCESS_TOKEN_MAX_ACTIVE=5
CHECKOUT_TTL_MINUTES=15
RESERVATION_TTL_MINUTES=15
ORDER_PENDING_TTL_MINUTES=30
GUEST_ORDER_ACCESS_TTL_DAYS=7

# Payments (fail-closed until a real provider adapter is configured)
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER_KEY=disabled
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_REDIRECT_ALLOWED_HOSTS=payment.zarinpal.com,sandbox.zarinpal.com
PAYMENT_RECONCILIATION_MAX_ATTEMPTS=8
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Enable only after the server egress IP is registered in ZarinPal gateway settings.
ZARINPAL_REVERSE_ENABLED=false
ZARINPAL_TIMEOUT_MS=10000
