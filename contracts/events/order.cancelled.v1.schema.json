{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.cancelled.v1",
  "title": "order.cancelled.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "order_number",
    "reservation_id",
    "reason_code",
    "note"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_number": {
      "type": "string"
    },
    "reservation_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    }
  }
}
