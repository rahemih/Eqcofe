{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fulfillment_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "fulfillment_id",
    "order_id",
    "status"
  ]
}
