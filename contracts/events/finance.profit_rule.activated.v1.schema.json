{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "active"
      ]
    },
    "activated_at": {},
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "status",
    "activated_at",
    "reason"
  ]
}
