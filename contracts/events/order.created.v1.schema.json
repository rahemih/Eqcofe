    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_number": {
      "type": "string"
    },
    "checkout_id": {
      "type": "string",
      "format": "uuid"
    },
    "reservation_id": {
      "type": "string",
      "format": "uuid"
    },
    "grand_total_toman": {
