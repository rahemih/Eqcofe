{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "format": "uuid"
    },
    "claim_number": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_item_id": {
      "type": "string",
      "format": "uuid"
    },
    "resolution": {
      "type": "string"
    },
    "quantity": {
      "type": [
        "integer",
        "null"
      ]
    },
    "refund_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "replacement_request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "resolution_note": {
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "claim_number",
    "order_id",
    "order_item_id",
    "resolution",
    "resolution_note"
  ]
}
