{
  "name": "eqcofe-backend",
  "version": "0.9.0",
  "private": true,
  "description": "EQCOFE modular-monolith backend — canonical source through Step 50/A2 (Excel workbook foundation)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev:api": "tsx watch apps/api/main.ts",
    "dev:worker": "tsx watch apps/worker/main.ts",
    "dev:scheduler": "tsx watch apps/scheduler/main.ts",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "start:scheduler": "node dist/apps/scheduler/main.js",
    "db:migrate": "tsx database/migrate.ts",
    "contract:validate": "node scripts/validate-openapi.mjs",
    "contract:types": "openapi-typescript contracts/http/openapi.yaml -o src/generated/openapi.ts",
    "arch:check": "node scripts/check-architecture.mjs",
    "policy:check": "node scripts/check-project-policies.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "pnpm contract:validate && pnpm arch:check && pnpm policy:check && pnpm build && pnpm test",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "bullmq": "5.67.2",
    "ioredis": "5.11.1",
    "kysely": "0.28.8",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0",
    "@simplewebauthn/server": "13.3.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
