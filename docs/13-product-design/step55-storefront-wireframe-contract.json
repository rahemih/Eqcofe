  "wireframeConventions": {
    "fidelity": "structural-low-fidelity",
    "requiredAnnotations": ["screen-id", "owner-gate", "viewport", "actor", "journey-id", "state", "source-reference", "primary-action", "recovery-action"],
    "contentRules": [
      "Use realistic Persian labels and content-length envelopes, not lorem ipsum.",
      "Use approved neutral media placeholders labelled by purpose; do not invent product photography, logo or brand art.",
      "Show integer values with Persian-readable grouping and the explicit unit تومان; never use Wallet terminology.",
      "Place Latin URLs, SKUs, hashes and order references in bidi-isolated samples.",
      "Mark server-authoritative values and do not imply provider success before verification."
    ],
    "interactionNotation": ["solid-arrow primary path", "dashed-arrow recovery path", "lock-marker unavailable action", "authority-marker server-owned fact", "annotation-note unresolved content dependency"],
    "layoutRegions": ["page-intro", "query-or-filter", "primary-content", "supporting-content", "summary", "primary-actions", "status-and-recovery", "related-content"]
  },
  "stateCoverage": {
    "families": {
      "load": ["initial", "progressive", "refresh"],
      "empty": ["first-use", "filtered", "no-result"],
      "input": ["validation", "server-validation", "conflict"],
      "access": ["unauthenticated", "denied", "scope-filtered", "step-up"],
      "provider": ["offline", "timeout", "unavailable", "unknown-result"],
      "mutation": ["submitting", "idempotent-replay", "partial", "success", "failed"],
      "lifecycle": ["pending", "active", "terminal", "expired", "reversed"],
      "availability": ["enabled", "disabled-with-reason", "out-of-stock", "price-changed", "quantity-invalid"]
    },
    "rules": [
      "Every async screen has initial loading plus refresh behavior that preserves context.",
      "Empty, filtered-empty and no-result states explain cause and give a relevant next action.",
      "Disabled actions expose a reason and do not replace server-side permission or validation.",
      "Unauthenticated, denied, not-found and expired-session states remain distinguishable.",
      "Unknown provider result offers authoritative status check, never fabricated success or uncontrolled duplicate payment.",
      "Form failure preserves safe user input and maps summary errors to affected fields.",
      "Recovery paths are bounded, idempotency-aware and retain an order/payment/case reference when available."
    ]
  },
