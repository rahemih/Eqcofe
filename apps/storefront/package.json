{
  "name": "@eqcofe/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "static-quality": "eslint app vite.config.ts react-router.config.ts",
    "verify": "pnpm typecheck && pnpm static-quality && pnpm build && pnpm shell:verify && pnpm api:verify",
    "shell:verify": "node ./scripts/verify-shell.mjs",
    "api:verify": "pnpm --dir ../.. exec tsx apps/storefront/scripts/verify-api-foundation.ts"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.70.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "@eslint/js": "10.0.1"
  }
}
