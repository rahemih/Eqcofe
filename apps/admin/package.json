{
  "name": "@eqcofe/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "static-quality": "eslint app vite.config.ts react-router.config.ts",
    "verify": "pnpm typecheck && pnpm static-quality && pnpm build && pnpm foundation:verify && pnpm transport:verify && pnpm shell:verify && pnpm auth-session:verify && pnpm permission-shell:verify && pnpm stepup-credentials:verify && pnpm dashboard-states:verify && pnpm catalog-read:verify && pnpm catalog-lifecycle:verify && pnpm acceptance:verify",
    "foundation:verify": "pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step67-foundation.ts",
    "transport:verify": "pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step67-transport.ts",
    "shell:verify": "node ./scripts/verify-step67-shell.mjs",
    "auth-session:verify": "pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step67-auth-session.ts",
    "permission-shell:verify": "node ./scripts/generate-step67-destinations.mjs --check && pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step67-permission-shell.ts",
    "stepup-credentials:verify": "pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step67-stepup-credentials.ts",
    "dashboard-states:verify": "pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step67-dashboard-states.ts",
    "acceptance:verify": "node ./scripts/verify-step67-acceptance.mjs",
    "catalog-read:verify": "pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step68-c-catalog-read.ts",
    "catalog-lifecycle:verify": "pnpm --dir ../.. exec tsx apps/admin/scripts/verify-step68-d-product-variant-lifecycle.ts"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
